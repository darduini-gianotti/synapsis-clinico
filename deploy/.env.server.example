# ==========================================
# .env.server — Variáveis de Ambiente para AWS Lightsail
# ESTE ARQUIVO FICA NO SERVIDOR (nunca commit no git!)
# Copie para /srv/synapsis/.env no servidor remoto
# ==========================================

# ------------------------------------------
# STAGING — staging.synapsisclinico.com.br
# ------------------------------------------

# JWT Secret para tokens de autenticação (staging)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
STAGING_JWT_SECRET=GERE_UMA_CHAVE_SEGURA_AQUI_64_CHARS

# Chave AES-256 para criptografia LGPD de dados clínicos (staging)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STAGING_CLINICAL_ENCRYPTION_KEY=GERE_64_CHARS_HEX_AQUI_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------
# PRODUÇÃO — app.synapsisclinico.com.br
# ------------------------------------------

# JWT Secret para tokens de autenticação (produção — DIFERENTE DO STAGING!)
PROD_JWT_SECRET=GERE_OUTRA_CHAVE_SEGURA_DIFERENTE_AQUI

# Chave AES-256 para criptografia LGPD de dados clínicos (produção — DIFERENTE DO STAGING!)
PROD_CLINICAL_ENCRYPTION_KEY=GERE_OUTRA_64_CHARS_HEX_AQUI_DIFERENTE

# ------------------------------------------
# COMPARTILHADAS
# ------------------------------------------

# Chave API do Google Gemini (para IA clínica)
GEMINI_API_KEY=SUA_CHAVE_GEMINI_AQUI

# IPs dos servidores (para o script deploy.sh)
STAGING_SERVER_IP=SEU_IP_ESTATICO_STAGING
PROD_SERVER_IP=SEU_IP_ESTATICO_PRODUCAO

# Caminho para a chave SSH .pem da AWS
SSH_KEY_PATH=~/.ssh/synapsis-lightsail.pem
