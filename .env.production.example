# ==========================================
# Configurações de Produção - Synapsis Clínico
# Copie este arquivo para .env no servidor AWS Lightsail
# ==========================================

# Porta de execução
PORT=3000
NODE_ENV=production

# Modo de inicialização do banco:
# SEED_DEMO_DATA=false e APP_MODE=clean criam a cópia 100% em branco (sem pacientes/sessões mockados)
SEED_DEMO_DATA=false
APP_MODE=clean
DB_FILE_PATH=/app/data/psico_database.sqlite

# Dados Iniciais da Psicóloga Titular / Administradora (Consultório da sua esposa):
ADMIN_NAME=Nome da Psicóloga
ADMIN_EMAIL=email@consultorio.com.br
ADMIN_PASSWORD=SuaSenhaSeguraAqui123!
ADMIN_CRP=CRP 06/123456-SP
CLINIC_NAME=Nome do Consultório da Esposa

# Chave secreta de autenticação JWT (gere uma chave aleatória e segura)
JWT_SECRET=defina_uma_chave_aleatoria_longa_aqui_ex_a89f7d6e1c2b3a4f5061

# Integração com Inteligência Artificial (Google Gemini) - Opcional
GEMINI_API_KEY=

# Integração com Cobrança Asaas (PIX / Boletos / Cartão) - Opcional
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
